<?xml version="1.0"?>
<package format="2">
  <name>surfel_fast_lio2_eigen</name>
  <version>0.1.0</version>
  <description>ROS1 adapter for Eigen-only FAST-LIO2 with a hierarchical surfel map.</description>
  <maintainer email="eungchang_mason@kaist.ac.kr">Eungchang Mason Lee</maintainer>
  <license>GPL-2.0-only</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>livox_ros_driver</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>roscpp</depend>
  <exec_depend>rviz</exec_depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tbb</depend>
</package>
